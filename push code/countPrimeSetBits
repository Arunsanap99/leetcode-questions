class Solution {

    public int countPrimeSetBits(int left, int right) {

        int count = 0;

        for (int n = left; n <= right; n++) {

            int bits = 0;
            int temp = n;

            // Count set bits
            while (temp != 0) {
                temp = temp & (temp - 1);
                bits++;
            }

            // Check prime
            if (isPrime(bits)) {
                count++;
            }
        }

        return count;
    }

    public boolean isPrime(int n) {

        if (n < 2) {
            return false;
        }

        for (int i = 2; i * i <= n; i++) {
            if (n % i == 0) {
                return false;
            }
        }

        return true;
    }
}
